# 防止 tsc 输出污染源码目录（此仓库以 TS 为主，src 下的 .js/.d.ts 视为生成物）
apps/**/src/**/*.js
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts
apps/**/src/**/*.d.ts.map

# Vite 的环境声明属于源码（不能被忽略）
!apps/**/src/**/vite-env.d.ts

# dev 专用 userData（可回收）
.tmp-specwave-userdata/

# 外部工具产物（避免污染仓库）
.kiro/

# SpecWave 会话/工作区状态（机器相关，不进版本库）
/.specwave/settings.json


# SpecWave 过程产物（AI 生成的中间稿/命令草稿，不属于需求资料）
.specwave/**/refs/create-*.txt
.terminal-paste/

# 本地工具脚本（不入库）
tools/
