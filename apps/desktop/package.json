{
  "name": "@specwave/desktop",
  "version": "0.0.0",
  "description": "SpecWave 桌面端应用",
  "private": true,
  "type": "commonjs",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "pnpm run build && electron-builder --win --x64",
    "preview": "electron-vite preview",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:headed": "pnpm run build && playwright test --headed",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.2",
    "@specwave/contracts": "workspace:*",
    "@specwave/ui-next": "workspace:*",
    "adm-zip": "^0.5.12",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.specwave.desktop",
    "productName": "SpecWave",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
