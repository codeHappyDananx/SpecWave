{
  "specwave": {
    "version": "0.4.0",
    "architecture": "tool-driven"
  },
  "executionGate": {
    "requiresExplicitApproval": true,
    "requiresRequirementConfirmation": true
  },
  "requirementsTemplate": {
    "templateId": "structured-json",
    "renderMode": "tool-driven",
    "toolName": "writeDoc"
  },
  "projectProbe": {
    "ignoreDirs": [
      ".git",
      ".specwave",
      "node_modules",
      "dist",
      "build",
      "out",
      ".next",
      ".turbo",
      ".cache",
      ".tmp-specwave-userdata"
    ]
  },
  "currentSession": null
}
